                Variable      "Declarations"
                Value         "#include <stdint.h>"
                Show          off
              }
              Parameter {
                Variable      "StartFcn"
                Value         ""
                Show          off
              }
              Parameter {
                Variable      "OutputFcn"
                Value         "int i;\n"
"uint32_t \tdata_in;\n"
"uint16_t \tdata_1;\n"
"uint16_t \tdata_2;\n"
"\n"
"for(i=0;i<NumInputSignals(0);i++)\n"
"\t{\n"
"\tdata_in = InputSignal(0,i);\n"
"\tdata_1 = (data_in & 0x0000FFFF);\n"
"\tdata_2 = (data_in & 0xFFFF0000) >> 16;\t\n"
"\tOutputSignal(0,2*i) \t\t= data_1;\n"
"\tOutputSignal(0,2*i+1) \t= data_2;\n"
"\t}"
                Show          off
              }
