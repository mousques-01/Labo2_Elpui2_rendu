Plecs {
  Name          "Labo2_AFE_HIL_RTBox_Noemie_LCL"
  Version       "5.0"
  CircuitModel  "ContStateSpace"
  StartTime     "0.0"
  TimeSpan      "2"
  Timeout       ""
  Solver        "auto"
  MaxStep       "1e-3"
  InitStep      "-1"
  FixedStep     "1e-3"
  Refine        "1"
  ZCStepSize    "1e-9"
  RelTol        "1e-3"
  AbsTol        "-1"
  TurnOnThreshold "0"
  NonIdealSwitchResistance "1"
  SyncFixedStepTasks "2"
  UseSingleCommonBaseRate "2"
  LossVariableLimitExceededMsg "3"
  NegativeSwitchLossMsg "3"
  DivisionByZeroMsg "3"
  DatatypeOverflowMsg "3"
  DatatypeInheritanceConflictMsg "2"
  ContSampleTimeConflictMsg "2"
  StiffnessDetectionMsg "2"
  MaxConsecutiveZCs "1000"
  AlgebraicLoopWithStateMachineMsg "3"
  AssertionAction "1"
  FixedPointDatatypeOverride "1"
  InitializationCommands "%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%"
"%%\n%%% Grid %%%\nL_grid = 20e-6;\t\t\t  %[H] Grid inductance\nf_grid = 50;\t"
"\t\t\t  %]Hz] Grid frequency\nV_grid = 230*sqrt(2);\t  %[V] Grid peak voltage"
"\n\nUn = V_grid/sqrt(2);      % [V]  Nominal RMS phase voltage\nSn = 10e3;   "
"             % [VA] Nominal apparent power\nZn = (Un^2) / Sn;         % [ohm]"
"  Base impedance\nIn = Sn /(3*Un);          % [A]  Nominal phase current\nIn_"
"max = In * sqrt(2);    % [A]  Maximum peak phase current\nCn = 1 / (2*pi*f_gr"
"id*Zn);% [F]  Base capacitance\n\n%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%"
"%%%%%%%%%%%\n%%% System %%%\nf_sw \t\t= 20e3;  \t\t\t% [Hz]\tSwitching/Sampli"
"ng frequency\nTs = 1/f_sw;              \t% [s]    Switching period\ndeadtime"
" = 500e-9;\t\t\t% [s]\t\tBlanking time\n\n\n%%% Inverter specific %%%\nfblink"
" = 2;\t\t\t\t\t\t% [Hz] LED blinking frequency\nCPU2.fs     = f_sw;\t\t\t% [H"
"z]\t    Sampling frequency for CPU2\nCPU1.fs     = CPU2.fs;\t\t% [Hz]      Sa"
"mpling frequency for CPU1\n\nspi_nb_data     = 8;    \t% [-]   Nb of 32 bit f"
"loats to sent (max 8)\nspi_clock       = 5e6;  \t% [Hz]  SPI clock frequency"
"\n\nRTbox.fspi  = CPU2.fs/20;  % RT-Box SPI communication frequency\nRTbox.fb"
"ase = 5*CPU2.fs;   % [Hz]      RT-Box CPU base frequency\n\n%%%%%%%%%%%%%%%%%"
"%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%\n%%% DC Bus %%%\nVDC = 800;\t\t\t\t\t\t"
"%[V] DC bus voltage\nC_DC = 1e-3;  \t\t\t\t\t%[F] DC bus capacitance\n\n%%%%%"
"%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%\n%%% L Filter %%%\nL_filter"
" = 6.68e-3;       % Total filter inductance\nR_filter = 0;   \t\t\t  % Total "
"filter resistance\n\n%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%\n"
"%%% Controller PLL %%%\nKp_pll = 31.733;\t\t\t\t\t\t%!!! PLL proportional gai"
"n\t\t\t\t\t\t<---- a modifier \nKi_pll = 103911.11;\t\t\t\t\t\t%!!! PLL integ"
"ral gain\t\t\t\t\t\t\t<---- a modifier\n\n%%% Controller Courant%%%\n\n%Kp_i "
"= 11 ;%22.2667; %44.5333;  \t\t\t\t\t\t%!!! Current controller proportional g"
"ain       <---- a modifier\n%Ki_i = 9277.76;%37111.11; %14844.4444%148444.44;"
" \n%!!! Current controller integral gain\t\n%Filtre LCL\nKp_i = 20.1333;\nKi_"
"i = 67111.11;\n\nV_sat = 500;              % Voltage saturation limit\n\n%%%%"
"%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%\n%%% Controller Tension %%"
"%\nKp_v = 0.5466; %1;  \t\t\t\t\t\t%!!! Voltage controller proportional gain"
"\t\t\t<---- a modifier\nKi_v = 45.55; %1639.67;         \t\t\t%!!! Voltage co"
"ntroller integral gain\t\t\t\t<---- a modifier\n\ni_sat = In_max;           %"
" [A] Current saturation limit\n\n%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%"
"%%%%%%%%%%\n% RT Box Analog out\n\nRTboxAO.fullscale = 5;\t\t\t% [V]\t\tRT bo"
"x analog out full scale voltage\nRTboxAO.margin_factor = 1.25;\t% [pu] \tmarg"
"in factor\n\nRTboxAO.Igrid.gain \t\t= RTboxAO.fullscale * 1/(RTboxAO.margin_f"
"actor*2*In_max); \t% Analog output scaling gain for grid current\nRTboxAO.Igr"
"id.offset \t= RTboxAO.fullscale/2; \t\t\t\t\t\t\t\t\t\t\t\t\t% Analog output "
"offset for grid current\nRTboxAO.Ugrid.gain \t\t= RTboxAO.fullscale * 1/(RTbo"
"xAO.margin_factor*2*V_grid); \t% Analog output scaling gain for grid voltage"
"\nRTboxAO.Ugrid.offset \t= RTboxAO.fullscale/2; \t\t\t\t\t\t\t\t\t\t\t\t\t% A"
"nalog output offset for grid voltage\nRTboxAO.UDC.gain \t\t\t= RTboxAO.fullsc"
"ale * 1/(2*VDC); \t\t\t\t\t\t\t\t\t% Analog output scaling gain for DC bus vo"
"ltage\nRTboxAO.UDC.offset \t\t= 0; \t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t% An"
"alog output offset for DC bus voltage\n\n\n%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%"
"%%%%%%%%%%%%%%%%%%%%\n% TI ControlCARD ADC constants\n\nADC.fullscale = RTbox"
"AO.fullscale * 0.65;\t% [V]\tADC full scale voltage\nADC.t_acq = 200e-9; \t\t"
"\t\t% [s]\tADC acquisition time (per channel)\n\nADC.Igrid.gain \t\t= RTboxAO"
".margin_factor*2*In_max/(ADC.fullscale); \t\t\t\t\t% ADC scaling gain for gri"
"d current\nADC.Igrid.offset \t\t= ADC.Igrid.gain * (-ADC.fullscale/2); \t\t\t"
"\t\t\t\t\t% ADC scaling offset for grid current\nADC.Ugrid.gain \t\t= RTboxAO"
".margin_factor*2*V_grid/(ADC.fullscale); \t\t\t\t\t% ADC scaling gain for gri"
"d voltage\nADC.Ugrid.offset \t\t= ADC.Ugrid.gain * (-ADC.fullscale/2); \t\t\t"
"\t\t\t\t\t% ADC scaling offset for grid voltage\nADC.UDC.gain \t\t\t= 2*VDC/("
"ADC.fullscale); \t\t\t\t\t\t\t\t\t\t\t\t\t% ADC scaling gain for DC bus volta"
"ge\nADC.UDC.offset \t\t= 0; \t% ADC scaling offset for DC bus voltage\n\n\n%%"
"%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%\n%Filtre LCL\nL_f"
"1 = 2e-3;\nL_f2 = 1.02e-3;\nR_f1 = 2.7;\nC_f = 10e-6;"
  InitialState  "1"
